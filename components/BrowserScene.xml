<?xml version="1.0" encoding="utf-8" ?>
<component name="BrowserScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/BrowserScene.brs" />
    
    <children>
        <!-- Background -->
        <Rectangle
            id="background"
            width="1920"
            height="1080"
            color="0x1a1a1aFF" />
        
        <!-- Header Bar -->
        <Rectangle
            id="headerBar"
            translation="[0,0]"
            width="1920"
            height="100"
            color="0x2d2d2dFF" />
        
        <!-- URL Bar Background -->
        <Rectangle
            id="urlBarBg"
            translation="[50,25]"
            width="1500"
            height="50"
            color="0x3d3d3dFF" />
        
        <!-- URL Input Label -->
        <Label
            id="urlLabel"
            translation="[60,32]"
            width="1480"
            height="40"
            font="font:MediumSystemFont"
            text="Enter URL or Search: www.example.com"
            color="0xCCCCCCFF"
            vertAlign="center" />
        
        <!-- Navigation Buttons -->
        <Label
            id="backButton"
            translation="[1570,32]"
            width="80"
            height="40"
            font="font:MediumBoldSystemFont"
            text="BACK"
            color="0xFFFFFFFF"
            horizAlign="center"
            vertAlign="center" />
        
        <Label
            id="forwardButton"
            translation="[1660,32]"
            width="100"
            height="40"
            font="font:MediumBoldSystemFont"
            text="FORWARD"
            color="0xFFFFFFFF"
            horizAlign="center"
            vertAlign="center" />
        
        <Label
            id="refreshButton"
            translation="[1770,32]"
            width="100"
            height="40"
            font="font:MediumBoldSystemFont"
            text="REFRESH"
            color="0xFFFFFFFF"
            horizAlign="center"
            vertAlign="center" />
        
        <!-- Content Area Background -->
        <Rectangle
            id="contentBg"
            translation="[50,120]"
            width="1820"
            height="900"
            color="0xFFFFFFFF" />
        
        <!-- Content Display -->
        <Label
            id="contentLabel"
            translation="[70,140]"
            width="1780"
            height="860"
            font="font:SmallSystemFont"
            text=""
            color="0x000000FF"
            wrap="true"
            vertAlign="top" />
        
        <!-- Status Bar -->
        <Rectangle
            id="statusBar"
            translation="[0,1030]"
            width="1920"
            height="50"
            color="0x2d2d2dFF" />
        
        <Label
            id="statusLabel"
            translation="[50,1038]"
            width="1820"
            height="40"
            font="font:SmallSystemFont"
            text="Ready. Press OK to enter URL, use arrow keys to navigate."
            color="0xCCCCCCFF"
            vertAlign="center" />
        
        <!-- Help Text -->
        <Label
            id="helpText"
            translation="[50,150]"
            width="1820"
            height="800"
            font="font:MediumSystemFont"
            text="Welcome to Roku Browser!&#10;&#10;Instructions:&#10;- Press OK/SELECT to enter a URL or search term&#10;- Use UP/DOWN arrow keys to scroll content&#10;- Press LEFT to go back&#10;- Press RIGHT to go forward&#10;- Press REPLAY to refresh&#10;- Press HOME to return to Roku home&#10;&#10;Note: Due to Roku platform limitations, this browser can fetch and display text content from websites. Full HTML rendering is not available on Roku devices.&#10;&#10;Try entering a URL like 'example.com' or a search term to get started!"
            color="0x000000FF"
            wrap="true"
            vertAlign="top"
            visible="true" />
    </children>
</component>
